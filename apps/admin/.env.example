# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=            # 48+ random bytes, base64url
DEVICE_TOKEN_PEPPER=       # 32+ random bytes, base64url
VIRUSTOTAL_API_KEY=        # reserved; reputation lookups are not implemented
NEXT_PUBLIC_SUPPORT_EMAIL= # shown on the public Support page
# Retention (days); see docs/OPERATIONS.md. Audit log is never deleted automatically.
RETENTION_DAYS_FINDINGS=180
RETENTION_DAYS_EVENTS=180
RETENTION_DAYS_QUARANTINE=365
RETENTION_DAYS_REVOKED_DEVICES=90
