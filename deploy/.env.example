# Copy to .env (never commit .env). install.sh does this for you.

# Required. From @BotFather. A secret: anyone who has it controls the bot.
SENTRIX_BOT_TOKEN=

# The HTTPS name of this server. install.sh fills it in (your domain, or <ip>.sslip.io). The desktop app talks to the bot through it.
DOMAIN=

# Optional tuning. By default the bot checks as many files at once as the server has cores.
# SENTRIX_DOC_WORKERS=8
